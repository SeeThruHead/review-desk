{
  "name": "review-desk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "bun run setup",
    "setup": "lefthook install",
    "moon": "moon",
    "check": "moon run :check --concurrency 1",
    "check:affected": "moon run :check --affected --concurrency 1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.7",
    "@moonrepo/cli": "2.6.4",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-bun": "4.1.2",
    "@effect/vitest": "4.1.2",
    "effect": "4.1.2"
  },
  "patchedDependencies": {
    "foldkit@0.170.0": "patches/foldkit@0.170.0.patch"
  }
}
