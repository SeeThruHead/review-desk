{
  "name": "@review-desk/server",
  "version": "0.6.4",
  "private": true,
  "bin": {
    "review-desk": "src/main.ts"
  },
  "type": "module",
  "scripts": {
    "typecheck": "effect-tsgo tsrs -p tsconfig.json",
    "lint": "effect-tsgo --tsrs-lint oxlint --type-aware --deny-warnings -c ../lint/oxlintrc.json src",
    "test": "bun --bun vitest run",
    "desk": "bun src/main.ts",
    "compile": "bun tools/compile.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.2",
    "@effect/sql-sqlite-bun": "4.1.2",
    "@review-desk/contract": "workspace:*",
    "@review-desk/domain": "workspace:*",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.7",
    "@effect/vitest": "4.1.2",
    "@types/bun": "1.4.3",
    "@vitest/coverage-istanbul": "5.0.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
